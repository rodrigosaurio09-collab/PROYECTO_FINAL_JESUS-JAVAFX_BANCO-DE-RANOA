<?xml version="1.0" encoding="UTF-8"?>

<?import javafx..scene.control.*?>
<?import javafx..scene.layout.*?>

<VBox
xmlns:fx="http://javafx.com/fxml"
fx:controller="com,proyecto.controllers.ProductController"
>

<Label text= "ADMINISTRACIÓN DE PRODUCTOS"/>
<GridPane>

    <Label text="NOMBRE PRODUCTO" GridPane.rowIndex="0"/>
    <TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="PRECIO" GridPane.rowIndex="1"/>
    <TextField fx:id="txtPrice" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Cantidad" GridPane.rowIndex="2"/>
    <TextField fx:id="txtQuantity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

</GridPane>  

 <hBox>

<Button text="Guardar" onAction="#create"/>

<Button text="Actualizar" onAction="#update"/>

<Button text="Eliminar" onAction="#delete"/>
 </hBox>

</VBox>